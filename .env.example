# Copy this file to .env before deploying with Docker Compose.
# For local demo, defaults in infra/docker-compose.yml can run without this file.

# Must match DB_PASS in each backend service .env when using the MySQL container.
MYSQL_ROOT_PASSWORD=change-me

# Must match AUTH_INTERNAL_TOKEN / INTERNAL_SERVICE_TOKEN used by backend services.
EV_INTERNAL_SERVICE_TOKEN=change-me

# NiFi sensitive properties key. Change this before exposing NiFi.
NIFI_SENSITIVE_PROPS_KEY=change-me

# Browser-facing API gateway URL.
# Local Docker: http://localhost:8080
# Google Compute Engine VM: http://YOUR_VM_EXTERNAL_IP:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
